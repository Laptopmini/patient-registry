            "type": "string"
          },
          "line1": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Line1",
            "type": "string"
          },
          "line2": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line2"
