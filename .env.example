# Copy to .env only if you need to override something. `docker compose up` works without it.
# Every value below is the default used when the variable is unset.

# ---- Ports published on the host ----
# Web app (Caddy serving the build; the Vite dev server under `make watch`)
WEB_PORT=8080
# API (OpenAPI docs at /docs)
API_PORT=8000

# ---- PostgreSQL (local development credentials only; never reuse them elsewhere) ----
POSTGRES_USER=registry
POSTGRES_PASSWORD=registry
POSTGRES_DB=registry

# ---- API ----
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log format: json (structured, the default) or console (human-readable)
LOG_FORMAT=json
# Seed synthetic patients on startup if the database is empty (idempotent)
SEED_ON_STARTUP=true
# How many synthetic patients to seed. Set 1000 or more to see list performance at scale.
# The seed only runs on an empty database, so after changing this run `docker compose down -v` first.
SEED_PATIENTS=20

# ---- AI summary provider (optional) ----
# Leave empty to use the offline template provider. With a key set, the `anthropic` provider is
# used only when the `summary-provider-anthropic` flag in flags/flags.json is on.
# Sending patient data to a third-party model would need a business associate agreement in production.
ANTHROPIC_API_KEY=
