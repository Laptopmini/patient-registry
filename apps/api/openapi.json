                {
                  "type": "null"
                }
              ],
              "description": "The current ETag of the patient, for example `\"3\"`.",
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientIn"
              }
            }
          },
          "required": true
